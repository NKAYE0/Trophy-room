<Prefab>
  <!-- Trophy room screen: framed weapon panels left and right, armour mannequin and shelf in the centre,
       display/edit mode toggle, item picker overlay. -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="InventoryBackground">
      <Children>

        <!-- Framed side panels (same frames as the vanilla inventory side panels) -->
        <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="540" HorizontalAlignment="Left" MarginTop="60" MarginBottom="120" Brush="Frame1Brush">
          <Children>
            <!-- Custom woven border, hidden for now -->
            <TextureWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" TextureProviderName="TrophyRoomPanelBorderTextureProvider" DoNotAcceptEvents="true" IsVisible="false" />
            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="TrophyRoom.Panel.Frame" DoNotAcceptEvents="true" />
          </Children>
        </BrushWidget>
        <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="540" HorizontalAlignment="Right" MarginTop="60" MarginBottom="120" Brush="Frame1Brush">
          <Children>
            <!-- Custom woven border, hidden for now -->
            <TextureWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" TextureProviderName="TrophyRoomPanelBorderTextureProvider" DoNotAcceptEvents="true" IsVisible="false" />
            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="TrophyRoom.Panel.Frame" DoNotAcceptEvents="true" />
          </Children>
        </BrushWidget>

        <!-- Header: clan banners either side of the title -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="14" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <MaskedTextureWidget DataSource="{ClanBanner}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="84" VerticalAlignment="Center" Brush="Clan.TornBanner" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" />
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="84" VerticalAlignment="Center" MarginLeft="28" MarginRight="28" Brush="InventoryHeaderFontBrush" Brush.FontSize="40" Brush.TextHorizontalAlignment="Center" Text="@TitleText" />
            <MaskedTextureWidget DataSource="{ClanBanner}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="84" VerticalAlignment="Center" Brush="Clan.TornBanner" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" />
          </Children>
        </ListPanel>

        <!-- Armour mannequin -->
        <CharacterTableauWidget DataSource="{Mannequin}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="860" SuggestedHeight="860" HorizontalAlignment="Center" VerticalAlignment="Center" PositionYOffset="-106" BannerCodeText="@BannerCodeText" CharStringId="@CharStringId" EquipmentCode="@EquipmentCode" BodyProperties="@BodyProperties" IsFemale="@IsFemale" MountCreationKey="@MountCreationKey" StanceIndex="@StanceIndex" ArmorColor1="@ArmorColor1" ArmorColor2="@ArmorColor2" Race="@Race" IdleAction="@IdleAction" RightHandWieldedEquipmentIndex="@RightHandWieldedEquipmentIndex" LeftHandWieldedEquipmentIndex="@LeftHandWieldedEquipmentIndex" IsEquipmentAnimActive="true" DoNotUseCustomScale="true" />

        <!-- Left weapon plaques: card on the left, stone name plate on the right -->
        <ListPanel DataSource="{LeftWeapons}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="24" PositionYOffset="-20" StackLayout.LayoutMethod="VerticalTopToBottom">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="470" SuggestedHeight="134" MarginTop="5" MarginBottom="5">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="216" SuggestedHeight="116" HorizontalAlignment="Left" VerticalAlignment="Center" Brush="TrophyRoom.Card.Sound" IsSelected="@IsSelected" IsVisible="@IsSlotVisible" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#4A1414FF" IsVisible="@HasItem" />
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InnerFrameShadow1Brush" IsVisible="@HasItem" />
                    <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#F4E1C426" IsVisible="@IsSelected" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="90" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@HasItem">
                      <Children>
                        <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                      </Children>
                    </Widget>
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="100" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="InventoryWeaponSlot" IsHidden="@HasItem" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="tournament_prize_frame_9" Color="#AD823CFF" IsVisible="@HasItem" />
                  </Children>
                </ButtonWidget>
                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="116" VerticalAlignment="Center" MarginLeft="228" Brush="Panel.Dent" IsVisible="@IsSlotVisible">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="TrophyRoom.Plate.Frame" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" VerticalAlignment="Top" MarginTop="12" MarginLeft="18" MarginRight="94" Brush="InventoryHeaderFontBrush" Brush.FontSize="16" Text="@NameText" IsVisible="@HasItem" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="52" VerticalAlignment="Top" MarginTop="54" MarginLeft="18" MarginRight="16" Brush="InventoryDefaultFontBrush" Brush.FontSize="15" Brush.FontColor="#EFC78DFF" Text="@InscriptionText" IsVisible="@HasInscription" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" MarginRight="16" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" Brush.AlphaFactor="0.5" Brush.TextHorizontalAlignment="Center" Text="@SlotLabel" IsHidden="@HasItem" />
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="12" MarginRight="66" Brush="Encyclopedia.Bookmark.Button" IsSelected="@IsFeatured" Command.Click="ExecuteToggleFeatured" IsVisible="@ShowFeatureToggle" />
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="22" SuggestedHeight="28" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="12" MarginRight="40" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteInscribe" IsVisible="@ShowEditControls">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="Clan\edit_name_icon" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="13" MarginRight="12" Brush="Popup.CloseButton" Command.Click="ExecuteClear" IsVisible="@ShowEditControls" />
                  </Children>
                </BrushWidget>
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>

        <!-- Right weapon plaques: stone name plate on the left, card on the right -->
        <ListPanel DataSource="{RightWeapons}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="24" PositionYOffset="-20" StackLayout.LayoutMethod="VerticalTopToBottom">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="470" SuggestedHeight="134" MarginTop="5" MarginBottom="5">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="216" SuggestedHeight="116" HorizontalAlignment="Right" VerticalAlignment="Center" Brush="TrophyRoom.Card.Sound" IsSelected="@IsSelected" IsVisible="@IsSlotVisible" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#4A1414FF" IsVisible="@HasItem" />
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InnerFrameShadow1Brush" IsVisible="@HasItem" />
                    <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#F4E1C426" IsVisible="@IsSelected" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="180" SuggestedHeight="90" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@HasItem">
                      <Children>
                        <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                      </Children>
                    </Widget>
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="100" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="InventoryWeaponSlot" IsHidden="@HasItem" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="tournament_prize_frame_9" Color="#AD823CFF" IsVisible="@HasItem" />
                  </Children>
                </ButtonWidget>
                <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="116" VerticalAlignment="Center" MarginRight="228" Brush="Panel.Dent" IsVisible="@IsSlotVisible">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="TrophyRoom.Plate.Frame" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" VerticalAlignment="Top" MarginTop="12" MarginLeft="94" MarginRight="18" Brush="InventoryHeaderFontBrush" Brush.FontSize="16" Brush.TextHorizontalAlignment="Right" Text="@NameText" IsVisible="@HasItem" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="52" VerticalAlignment="Top" MarginTop="54" MarginLeft="16" MarginRight="18" Brush="InventoryDefaultFontBrush" Brush.FontSize="15" Brush.FontColor="#EFC78DFF" Brush.TextHorizontalAlignment="Right" Text="@InscriptionText" IsVisible="@HasInscription" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" MarginRight="16" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" Brush.AlphaFactor="0.5" Brush.TextHorizontalAlignment="Center" Text="@SlotLabel" IsHidden="@HasItem" />
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="13" MarginLeft="12" Brush="Popup.CloseButton" Command.Click="ExecuteClear" IsVisible="@ShowEditControls" />
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="26" SuggestedHeight="26" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="12" MarginLeft="66" Brush="Encyclopedia.Bookmark.Button" IsSelected="@IsFeatured" Command.Click="ExecuteToggleFeatured" IsVisible="@ShowFeatureToggle" />
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="22" SuggestedHeight="28" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="12" MarginLeft="40" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteInscribe" IsVisible="@ShowEditControls">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="Clan\edit_name_icon" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </BrushWidget>
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>

        <!-- Armour shelf: set inscription on top, armour cards below -->
        <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="744" SuggestedHeight="226" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="104" Brush="TrophyRoom.Shelf" IsVisible="@ShowArmourDisplay">
          <Children>
            <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Top" MarginTop="14" MarginLeft="30" MarginRight="30" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteInscribeArmour" IsVisible="@ShowArmourInscriptionPlate">
              <Children>
                <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem" IsVisible="@IsEditMode" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="36" MarginRight="36" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" Brush.FontColor="#EFC78DFF" Brush.TextHorizontalAlignment="Center" Text="@ArmourInscriptionText" IsVisible="@HasArmourInscription" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="36" MarginRight="36" Brush="InventoryDefaultFontBrush" Brush.FontSize="17" Brush.AlphaFactor="0.55" Brush.TextHorizontalAlignment="Center" Text="@AddArmourInscriptionText" IsVisible="@ShowArmourInscriptionPrompt" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="19" SuggestedHeight="24" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="8" Sprite="Clan\edit_name_icon" IsVisible="@IsEditMode" />
              </Children>
            </ButtonWidget>

            <ListPanel DataSource="{ArmourSlots}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="14" StackLayout.LayoutMethod="HorizontalLeftToRight">
              <ItemTemplate>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="146" SuggestedHeight="146" MarginLeft="0" MarginRight="0">
                  <Children>
                    <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="140" SuggestedHeight="110" HorizontalAlignment="Center" VerticalAlignment="Top" Brush="TrophyRoom.Card.Sound" IsSelected="@IsSelected" IsVisible="@IsSlotVisible" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#4A1414FF" IsVisible="@HasItem" />
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InnerFrameShadow1Brush" IsVisible="@HasItem" />
                        <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#F4E1C426" IsVisible="@IsSelected" />
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="124" SuggestedHeight="62" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@HasItem">
                          <Children>
                            <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                          </Children>
                        </Widget>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="136" SuggestedHeight="68" HorizontalAlignment="Center" VerticalAlignment="Center" IsHidden="@HasItem">
                          <Children>
                            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryHelmetSlot" IsVisible="@IsHeadSlot" />
                            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryCloakSlot" IsVisible="@IsCapeSlot" />
                            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryArmorSlot" IsVisible="@IsBodySlot" />
                            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryGloveSlot" IsVisible="@IsGlovesSlot" />
                            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryBootSlot" IsVisible="@IsLegsSlot" />
                          </Children>
                        </Widget>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="tournament_prize_frame_9" Color="#AD823CFF" IsVisible="@HasItem" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="22" SuggestedHeight="22" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="6" MarginRight="10" Brush="Popup.CloseButton" Command.Click="ExecuteClear" IsVisible="@ShowEditControls" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" VerticalAlignment="Bottom" Brush="InventoryDefaultFontBrush" Brush.FontSize="17" Brush.TextHorizontalAlignment="Center" Text="@SlotLabel" IsVisible="@IsEditMode" />
                  </Children>
                </Widget>
              </ItemTemplate>
            </ListPanel>
          </Children>
        </BrushWidget>

        <!-- Display / edit mode toggle -->
        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="230" SuggestedHeight="56" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="20" PositionXOffset="-560" Brush="ButtonBrush2" Command.Click="ExecuteToggleEditMode">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryHeaderFontBrush" Brush.FontSize="22" Brush.TextHorizontalAlignment="Center" Text="@ToggleModeText" />
          </Children>
        </ButtonWidget>

        <!-- Mannequin stance selector (edit mode), mirroring the mode toggle on the other side -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="27" PositionXOffset="560" StackLayout.LayoutMethod="HorizontalLeftToRight" IsVisible="@IsEditMode">
          <Children>
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="37" SuggestedHeight="42" VerticalAlignment="Center" Brush="Inventory.Tabbard.PreviousCharacter" Command.Click="ExecutePreviousPose" />
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="280" SuggestedHeight="42" VerticalAlignment="Center" MarginLeft="6" MarginRight="6" Sprite="BlankWhiteSquare_9" Color="#0000008C">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="8" MarginRight="8" Brush="InventoryHeaderFontBrush" Brush.FontSize="19" Brush.TextHorizontalAlignment="Center" Text="@PoseText" />
              </Children>
            </Widget>
            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="37" SuggestedHeight="42" VerticalAlignment="Center" Brush="Inventory.Tabbard.NextCharacter" Command.Click="ExecuteNextPose" />
          </Children>
        </ListPanel>

        <!-- Done / Cancel (edit mode) or Leave (display mode) -->
        <Standard.DialogCloseButtons Parameter.ShowCancel="@IsEditMode" Parameter.CancelButtonAction="ExecuteCancel" Parameter.CancelButtonText="@CancelText" Parameter.DoneButtonAction="ExecuteDone" Parameter.DoneButtonText="@DoneText" Parameter.DoneInputKeyDataSource="{DoneInputKey}" Parameter.CancelInputKeyDataSource="{CancelInputKey}" />

        <!-- Item picker overlay -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsPickerOpen">
          <Children>
            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteClosePicker">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000B4" DoNotAcceptEvents="true" />
              </Children>
            </ButtonWidget>

            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="720" SuggestedHeight="820" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#17120EF8">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Top" MarginTop="75" MarginLeft="20" MarginRight="20" Sprite="BlankWhiteSquare_9" Color="#F4E1C460" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" VerticalAlignment="Top" MarginTop="18" MarginLeft="60" MarginRight="60" Brush="InventoryHeaderFontBrush" Brush.FontSize="28" Brush.TextHorizontalAlignment="Center" Text="@PickerTitleText" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="36" SuggestedHeight="36" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="20" MarginRight="20" Brush="Popup.CloseButton" Command.Click="ExecuteClosePicker" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Center" MarginLeft="40" MarginRight="40" Brush="InventoryDefaultFontBrush" Brush.FontSize="22" Brush.TextHorizontalAlignment="Center" Text="@NoCandidatesText" IsVisible="@HasNoCandidates" />

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="90" MarginBottom="20" MarginLeft="20" MarginRight="20">
                  <Children>
                    <ScrollablePanel Id="ScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="20" AutoHideScrollBars="true" ClipRect="ClipRect" InnerPanel="ClipRect\CandidateList" VerticalScrollbar="..\VerticalScrollbar">
                      <Children>
                        <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="CandidateList" DataSource="{Candidates}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="90" MarginBottom="6" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#00000070" />
                                    <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="140" SuggestedHeight="70" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" Sprite="Inventory\portrait_cart">
                                      <Children>
                                        <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="3" MarginRight="4" MarginTop="3" MarginBottom="4" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                                      </Children>
                                    </Widget>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Top" MarginTop="10" MarginLeft="170" MarginRight="10" Brush="InventoryHeaderFontBrush" Brush.FontSize="20" Text="@NameText" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" VerticalAlignment="Bottom" MarginBottom="10" MarginLeft="170" MarginRight="10" Brush="InventoryDefaultFontBrush" Brush.FontSize="16" Brush.AlphaFactor="0.7" Text="@SourceText" />
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>

                    <ScrollbarWidget Id="VerticalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Top" AlignmentAxis="Vertical" Handle="VerticalScrollbarHandle" MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#5a4033FF" AlphaFactor="0.2" />
                        <ImageWidget Id="VerticalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="4" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>
          </Children>
        </Widget>

        <!-- Inspect overlay: large rotating 3D view of a displayed item (display mode) -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsInspectOpen">
          <Children>
            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteCloseInspect">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000C8" DoNotAcceptEvents="true" />
              </Children>
            </ButtonWidget>
            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="820" SuggestedHeight="860" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="TrophyRoom.Shelf">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" VerticalAlignment="Top" MarginTop="22" MarginLeft="70" MarginRight="70" Brush="InventoryHeaderFontBrush" Brush.FontSize="30" Brush.TextHorizontalAlignment="Center" Text="@InspectNameText" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="36" SuggestedHeight="36" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="22" MarginRight="22" Brush="Popup.CloseButton" Command.Click="ExecuteCloseInspect" />
                <ItemTableauWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="760" SuggestedHeight="700" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="84" StringId="@InspectStringId" ItemModifierId="@InspectItemModifierId" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" VerticalAlignment="Bottom" MarginBottom="22" Brush="InventoryDefaultFontBrush" Brush.FontSize="17" Brush.AlphaFactor="0.6" Brush.TextHorizontalAlignment="Center" Text="@InspectHintText" />
              </Children>
            </BrushWidget>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
