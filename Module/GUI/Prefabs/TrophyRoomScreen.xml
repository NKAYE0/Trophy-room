<Prefab>
  <!-- Trophy room screen: clan banner header, weapon plaques left and right, armour mannequin in the centre, item picker overlay. -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="InventoryBackground">
      <Children>

        <!-- Header: clan banners either side of the title -->
        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="14" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <Children>
            <MaskedTextureWidget DataSource="{ClanBanner}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="84" VerticalAlignment="Center" Brush="Clan.TornBanner" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" />
            <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="84" VerticalAlignment="Center" MarginLeft="28" MarginRight="28" Brush="InventoryHeaderFontBrush" Brush.FontSize="40" Brush.TextHorizontalAlignment="Center" Text="@TitleText" />
            <MaskedTextureWidget DataSource="{ClanBanner}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="84" VerticalAlignment="Center" Brush="Clan.TornBanner" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" />
          </Children>
        </ListPanel>

        <!-- Armour mannequin -->
        <CharacterTableauWidget DataSource="{Mannequin}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="760" SuggestedHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" PositionYOffset="-90" BannerCodeText="@BannerCodeText" CharStringId="@CharStringId" EquipmentCode="@EquipmentCode" BodyProperties="@BodyProperties" IsFemale="@IsFemale" MountCreationKey="@MountCreationKey" StanceIndex="@StanceIndex" ArmorColor1="@ArmorColor1" ArmorColor2="@ArmorColor2" Race="@Race" IsEquipmentAnimActive="true" DoNotUseCustomScale="true" />

        <!-- Left weapon plaques: card on the left, engraved plate on the right -->
        <ListPanel DataSource="{LeftWeapons}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="30" PositionYOffset="-30" StackLayout.LayoutMethod="VerticalTopToBottom">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="470" SuggestedHeight="134" MarginTop="5" MarginBottom="5">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="116" HorizontalAlignment="Left" VerticalAlignment="Center" Brush="TrophyRoom.Card.Sound" IsSelected="@IsSelected" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="TrophyRoom.Card.Base" IsVisible="@HasItem" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="80" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@HasItem">
                      <Children>
                        <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                      </Children>
                    </Widget>
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="100" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="InventoryWeaponSlot" IsHidden="@HasItem" />
                  </Children>
                </ButtonWidget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="114" VerticalAlignment="Center" MarginLeft="212" Sprite="BlankWhiteSquare_9" Color="#0000008C">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="#C8A46A80" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" VerticalAlignment="Top" MarginTop="8" MarginLeft="12" MarginRight="62" Brush="InventoryHeaderFontBrush" Brush.FontSize="16" Text="@NameText" IsVisible="@HasItem" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58" VerticalAlignment="Top" MarginTop="52" MarginLeft="12" MarginRight="12" Brush="InventoryDefaultFontBrush" Brush.FontSize="15" Brush.FontColor="#EFC78DFF" Text="@InscriptionText" IsVisible="@HasInscription" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="12" MarginRight="12" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" Brush.AlphaFactor="0.5" Brush.TextHorizontalAlignment="Center" Text="@SlotLabel" IsHidden="@HasItem" />
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="22" SuggestedHeight="28" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="8" MarginRight="36" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteInscribe" IsVisible="@HasItem">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="Clan\edit_name_icon" />
                      </Children>
                    </ButtonWidget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="9" MarginRight="8" Brush="Popup.CloseButton" Command.Click="ExecuteClear" IsVisible="@HasItem" />
                  </Children>
                </Widget>
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>

        <!-- Right weapon plaques: engraved plate on the left, card on the right -->
        <ListPanel DataSource="{RightWeapons}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="30" PositionYOffset="-30" StackLayout.LayoutMethod="VerticalTopToBottom">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="470" SuggestedHeight="134" MarginTop="5" MarginBottom="5">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="116" HorizontalAlignment="Right" VerticalAlignment="Center" Brush="TrophyRoom.Card.Sound" IsSelected="@IsSelected" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="TrophyRoom.Card.Base" IsVisible="@HasItem" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="80" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@HasItem">
                      <Children>
                        <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                      </Children>
                    </Widget>
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="100" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="InventoryWeaponSlot" IsHidden="@HasItem" />
                  </Children>
                </ButtonWidget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="114" VerticalAlignment="Center" MarginRight="212" Sprite="BlankWhiteSquare_9" Color="#0000008C">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="#C8A46A80" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" VerticalAlignment="Top" MarginTop="8" MarginLeft="62" MarginRight="12" Brush="InventoryHeaderFontBrush" Brush.FontSize="16" Brush.TextHorizontalAlignment="Right" Text="@NameText" IsVisible="@HasItem" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="58" VerticalAlignment="Top" MarginTop="52" MarginLeft="12" MarginRight="12" Brush="InventoryDefaultFontBrush" Brush.FontSize="15" Brush.FontColor="#EFC78DFF" Brush.TextHorizontalAlignment="Right" Text="@InscriptionText" IsVisible="@HasInscription" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="12" MarginRight="12" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" Brush.AlphaFactor="0.5" Brush.TextHorizontalAlignment="Center" Text="@SlotLabel" IsHidden="@HasItem" />
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="9" MarginLeft="8" Brush="Popup.CloseButton" Command.Click="ExecuteClear" IsVisible="@HasItem" />
                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="22" SuggestedHeight="28" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="8" MarginLeft="36" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteInscribe" IsVisible="@HasItem">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="Clan\edit_name_icon" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>

        <!-- Armour set inscription plate -->
        <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="700" SuggestedHeight="44" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="300" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteInscribeArmour" IsVisible="@CanInscribeArmour">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#0000008C" />
            <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare_9" Color="#C8A46A80" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="40" MarginRight="40" Brush="InventoryDefaultFontBrush" Brush.FontSize="18" Brush.FontColor="#EFC78DFF" Brush.TextHorizontalAlignment="Center" Text="@ArmourInscriptionText" IsVisible="@HasArmourInscription" />
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="40" MarginRight="40" Brush="InventoryDefaultFontBrush" Brush.FontSize="17" Brush.AlphaFactor="0.55" Brush.TextHorizontalAlignment="Center" Text="@AddArmourInscriptionText" IsHidden="@HasArmourInscription" />
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="19" SuggestedHeight="24" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="12" Sprite="Clan\edit_name_icon" />
          </Children>
        </ButtonWidget>

        <!-- Armour plaques under the mannequin -->
        <ListPanel DataSource="{ArmourSlots}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="128" StackLayout.LayoutMethod="HorizontalLeftToRight">
          <ItemTemplate>
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="176" SuggestedHeight="162" MarginLeft="2" MarginRight="2">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="166" SuggestedHeight="128" HorizontalAlignment="Center" VerticalAlignment="Top" Brush="TrophyRoom.Card.Sound" IsSelected="@IsSelected" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                  <Children>
                    <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="TrophyRoom.Card.Base" IsVisible="@HasItem" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="140" SuggestedHeight="70" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="@HasItem">
                      <Children>
                        <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                      </Children>
                    </Widget>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="166" SuggestedHeight="83" HorizontalAlignment="Center" VerticalAlignment="Center" IsHidden="@HasItem">
                      <Children>
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryHelmetSlot" IsVisible="@IsHeadSlot" />
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryCloakSlot" IsVisible="@IsCapeSlot" />
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryArmorSlot" IsVisible="@IsBodySlot" />
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryGloveSlot" IsVisible="@IsGlovesSlot" />
                        <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="InventoryBootSlot" IsVisible="@IsLegsSlot" />
                      </Children>
                    </Widget>
                  </Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="22" SuggestedHeight="22" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="10" MarginRight="16" Brush="Popup.CloseButton" Command.Click="ExecuteClear" IsVisible="@HasItem" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" VerticalAlignment="Bottom" Brush="InventoryDefaultFontBrush" Brush.FontSize="17" Brush.TextHorizontalAlignment="Center" Text="@SlotLabel" />
              </Children>
            </Widget>
          </ItemTemplate>
        </ListPanel>

        <!-- Done / Cancel -->
        <Standard.DialogCloseButtons Parameter.CancelButtonAction="ExecuteCancel" Parameter.CancelButtonText="@CancelText" Parameter.DoneButtonAction="ExecuteDone" Parameter.DoneButtonText="@DoneText" Parameter.DoneInputKeyDataSource="{DoneInputKey}" Parameter.CancelInputKeyDataSource="{CancelInputKey}" />

        <!-- Item picker overlay -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@IsPickerOpen">
          <Children>
            <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteClosePicker">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000B4" DoNotAcceptEvents="true" />
              </Children>
            </ButtonWidget>

            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="720" SuggestedHeight="820" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#17120EF8">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Top" MarginTop="75" MarginLeft="20" MarginRight="20" Sprite="BlankWhiteSquare_9" Color="#F4E1C460" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" VerticalAlignment="Top" MarginTop="18" MarginLeft="60" MarginRight="60" Brush="InventoryHeaderFontBrush" Brush.FontSize="28" Brush.TextHorizontalAlignment="Center" Text="@PickerTitleText" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="36" SuggestedHeight="36" HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="20" MarginRight="20" Brush="Popup.CloseButton" Command.Click="ExecuteClosePicker" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Center" MarginLeft="40" MarginRight="40" Brush="InventoryDefaultFontBrush" Brush.FontSize="22" Brush.TextHorizontalAlignment="Center" Text="@NoCandidatesText" IsVisible="@HasNoCandidates" />

                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="90" MarginBottom="20" MarginLeft="20" MarginRight="20">
                  <Children>
                    <ScrollablePanel Id="ScrollablePanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="20" AutoHideScrollBars="true" ClipRect="ClipRect" InnerPanel="ClipRect\CandidateList" VerticalScrollbar="..\VerticalScrollbar">
                      <Children>
                        <Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <ListPanel Id="CandidateList" DataSource="{Candidates}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <ItemTemplate>
                                <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="90" MarginBottom="6" Brush="Standard.DropdownItem.SoundBrush" Command.Click="ExecuteSelect" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint">
                                  <Children>
                                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#00000070" />
                                    <ImageWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Standard.DropdownItem" />
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="140" SuggestedHeight="70" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="10" Sprite="Inventory\portrait_cart">
                                      <Children>
                                        <ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="3" MarginRight="4" MarginTop="3" MarginBottom="4" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" />
                                      </Children>
                                    </Widget>
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" VerticalAlignment="Top" MarginTop="10" MarginLeft="170" MarginRight="10" Brush="InventoryHeaderFontBrush" Brush.FontSize="20" Text="@NameText" />
                                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" VerticalAlignment="Bottom" MarginBottom="10" MarginLeft="170" MarginRight="10" Brush="InventoryDefaultFontBrush" Brush.FontSize="16" Brush.AlphaFactor="0.7" Text="@SourceText" />
                                  </Children>
                                </ButtonWidget>
                              </ItemTemplate>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>

                    <ScrollbarWidget Id="VerticalScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" VerticalAlignment="Top" AlignmentAxis="Vertical" Handle="VerticalScrollbarHandle" MaxValue="100" MinValue="0">
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="2" HorizontalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#5a4033FF" AlphaFactor="0.2" />
                        <ImageWidget Id="VerticalScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="10" SuggestedWidth="4" HorizontalAlignment="Center" Brush="FaceGen.Scrollbar.Handle" Brush.AlphaFactor="0.7" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
